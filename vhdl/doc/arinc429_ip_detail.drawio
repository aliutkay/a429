<mxfile host="app.diagrams.net"><diagram id="detail" name="Ayrıntılı sinyal diyagramı"><mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="1" pageScale="1" pageWidth="8584" pageHeight="5378" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="arinc429_ip — Ayrıntılı sinyal diyagramı (v0.5)" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2400" height="44" as="geometry"/></mxCell><mxCell id="c3" value="Bloklarda girişler solda, çıkışlar sağda. Bir hat, aynı adı taşıyan çıkışı ve girişleri bağlar. clk ve rst_n bütün bloklara gider (çizilmedi). (i) = RX generate indeksi. Hat kesişmelerinde yay (jump) = bağlantı yok." style="text;html=1;fontSize=13;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="3000" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Global: APB, Register Bank, Timestamp" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="127" y="198" width="2637" height="638" as="geometry"/></mxCell><mxCell id="c5" value="a429_tx_channel  (G_TX_EN)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f3f9f1;strokeColor=#82b366;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="127" y="1078" width="8357" height="704" as="geometry"/></mxCell><mxCell id="c6" value="TX BIT kanalı  (G_TXBIT_EN) = a429_rx_channel (G_HAS_CHECKER = true, G_HAS_LABEL_FILTER = false)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fdf3e7;strokeColor=#c47a1a;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop