<mxfile host="app.diagrams.net"><diagram id="1 " name="1 Genel yapı"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 2" value="arinc429_ip — Genel Mimari (generic: TX 0/1 · TX BIT 0/1 · RX 0–16)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="1 3" value="arinc429_ip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="80" width="950" height="800" as="geometry"/></mxCell><mxCell id="1 4" value="&lt;b&gt;APB3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;AXI4-Lite master&lt;br&gt;→ AXI interconnect&lt;br&gt;→ AXI-APB bridge&lt;br&gt;(IP clock'unda)&lt;br&gt;paddr[15:0] IP çözer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="160" height="130" as="geometry"/></mxCell><mxCell id="1 5" value="&lt;b&gt;APB Slave + Register Bank&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Global (ID 00)&lt;br&gt;  ID, VERSION, CAPS, CLK_HZ&lt;br&gt;  SOFT_RESET, GLOBAL_FREEZE&lt;br&gt;  TS_CTRL / TS okuma&lt;br&gt;  ROUTE_CTRL / maskeler&lt;br&gt;&lt;br&gt;TX sayfası (ID 01)&lt;br&gt;TX BIT sayfası (ID 02)&lt;br&gt;RX0–RX15 (ID 10–1F)&lt;br&gt;&lt;br&gt;Her modül: CFG_SEL&lt;br&gt;  0 High Speed 100k&lt;br&gt;  1 Low Speed 12.5k&lt;br&gt;  2 Custom&lt;br&gt;  + CFG_APPLY&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="120" width="200" height="560" as="geometry"/></mxCell><mxCell id="1 6" value="&lt;b&gt;Timestamp Generator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;64 bit, her clk +1&lt;br&gt;tüm logger'lara ts_now&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="220" y="710" width="200" height="80" as="geometry"/></mxCell><mxCell id="1 7" value="TX kanal (G_TX_EN)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fillColor=#f3f9f1;strokeColor=#82b366;fontColor=#3d6b2f;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="300" height="170" as="geometry"/></mxCell><mxCell id="1 8" value="&lt;b&gt;cfg_sel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;preset/custom&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="485" y="145" width="110" height="60" as="geometry"/></mxCell><mxCell id="1 9" value="&lt;b&gt;tx_core&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(mevcut kod)&lt;br&gt;MUX1 Builder/ext&lt;br&gt;MUX2 Sched/trigger&lt;br&gt;MUX3 TX/Override&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="610" y="145" width="145" height="120" as="geometry"/></mxCell><mxCell id="1 10" value="&lt;b&gt;TX Router&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;route = 0 → line driver&lt;br&gt;   (reset)&lt;br&gt;route = 1 → RX TESTA/TESTB&lt;br&gt;   (G_RX_TEST_EN, maske)&lt;br&gt;   line driver NULL/HIGH-Z&lt;br&gt;NULL test pinine 11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="220" height="200" as="geometry"/></mxCell><mxCell id="1 11" value="TX BIT kanal (G_TXBIT_EN)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fillColor=#fdf6ec;strokeColor=#d79b00;fontColor=#9a6a00;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="570" height="140" as="geometry"/></mxCell><mxCell id="1 12" value="&lt;b&gt;rx_channel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;CDC → Glitch Filter → Receiver → Logger&lt;br&gt;Word / Bit / Error RAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="485" y="365" width="330" height="90" as="geometry"/></mxCell><mxCell id="1 13" value="&lt;b&gt;Word Checker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;beklenen Word FIFO&lt;br&gt;mismatch / no_echo /&lt;br&gt;unexpected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="835" y="365" width="190" height="90" as="geometry"/></mxCell><mxCell id="1 14" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=60;" vertex="1" parent="1"><mxGeometry x="494" y="534" width="570" height="120" as="geometry"/></mxCell><mxCell id="1 15" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=60;" vertex="1" parent="1"><mxGeometry x="482" y="522" width="570" height="120" as="geometry"/></mxCell><mxCell id="1 16" value="RX kanal × G_NUM_RX (0–16)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fillColor=#fff8f0;strokeColor=#d79b00;fontColor=#9a6a00;" vertex="1" parent="1"><mxGeometry x="470" y="510" width="570" height="120" as="geometry"/></mxCell><mxCell id="1 17" value="&lt;b&gt;rx_channel (RX0 … RX15)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;CDC → Glitch Filter → Receiver → Label Filter → Logger → Word / Bit / Error RAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="485" y="545" width="540" height="70" as="geometry"/></mxCell><mxCell id="1 18" value="&lt;b&gt;Ana fikirler&lt;/b&gt;&lt;br&gt;• Her alıcı (TX BIT dahil) aynı &lt;i&gt;rx_channel&lt;/i&gt; entity'si, kendi logger ve belleği&lt;br&gt;• Tek timestamp → kanallar arası zaman doğrudan kıyaslanır&lt;br&gt;• Config: gömülü preset (100k / 12.5k) veya custom, shadow → APPLY ile güvenli geçiş&lt;br&gt;• TX çıkışı ya line driver'a ya seçili RX'lerin test pinlerine gider&lt;br&gt;• Checker kaynağı TX BIT veya herhangi bir RX kanalı olabilir&lt;br&gt;• Tek clock domain; HIGH-Z = tx_high/low 11 (sürücü destekliyorsa)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="680" width="570" height="180" as="geometry"/></mxCell><mxCell id="1 19" value="tx_high / tx_low" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="150" height="36" as="geometry"/></mxCell><mxCell id="1 20" value="tx_slp" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="200" width="150" height="36" as="geometry"/></mxCell><mxCell id="1 21" value="rx_test_a/b [N] (ops.)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="260" width="150" height="36" as="geometry"/></mxCell><mxCell id="1 22" value="txbit_rx_high/low" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="395" width="150" height="36" as="geometry"/></mxCell><mxCell id="1 23" value="rx_high/low [N]" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="560" width="150" height="36" as="geometry"/></mxCell><mxCell id="1 24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="1 4" target="1 5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 25" value="TX regs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 5" target="1 8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 26" value="cfg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3d6b2f;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 8" target="1 9"><mxGeometry relative="1" as="geometry"><