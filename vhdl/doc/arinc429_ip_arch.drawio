okeColor=#666666;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.83;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 5" target="1 17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 38" value="ts_now" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b08b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 6" target="1 12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="518" y="734"/></Array></mxGeometry></mxCell><mxCell id="1 39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b08b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 6" target="1 17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="2 " name="2 RX kanal"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 2" value="a429_rx_channel — RX ve TX BIT için ortak kanal" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="2 3" value="a429_rx_channel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1340" height="620" as="geometry"/></mxCell><mxCell id="2 4" value="rx_high/low" style="shape=