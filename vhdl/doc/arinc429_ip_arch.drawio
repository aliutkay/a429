" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="280" height="200" as="geometry"/></mxCell><mxCell id="2 9" value="&lt;b&gt;Word RAM&lt;/b&gt;&lt;br&gt;256 × 144" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="110" height="110" as="geometry"/></mxCell><mxCell id="2 10" value="&lt;b&gt;Error RAM&lt;/b&gt;&lt;br&gt;256 × 128" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="525" width="110" height="110" as="geometry"/></mxCell><mxCell id="2 11" value="&lt;b&gt;Bit RAM&lt;/b&gt;&lt;br&gt;8×32 × 64" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="610" width="110" height="80" as="geometry"/></mxCell><mxCell id="2 12" value="&lt;b&gt;a429_cfg_sel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;CFG_SEL: HS / LS / Custom&lt;br&gt;shadow → active&lt;br&gt;(FSM IDLE'da APPLY)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="170" height="120" as="geometry"/></mxCell><mxCell id="2 13" value="&lt;b&gt;Kanal Register'ları&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;CTRL (enable, freeze,&lt;br&gt;  clear, input_sel)&lt;br&gt;STATUS&lt;br&gt;CFG_SEL / CFG_APPLY&lt;br&gt;CFG_* custom (8 adet)&lt;br&gt;ACT_* geri okuma&lt;br&gt;WORD/ERR/DROP/FRAME_CNT&lt;br&gt;LAST_WORD&lt;br